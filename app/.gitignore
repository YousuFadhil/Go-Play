# Platform build outputs
android/.gradle/
android/local.properties
ios/Pods/
ios/.symlinks/

# Secrets
*.env
# Firebase project configuration. Carries the project's own identifiers, is
# per-environment, and the Android build applies google-services only when the
# file is present — so a checkout without it still builds, without push.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# The web equivalent, generated by `tool/generate_firebase_sw.dart` from the
# committed template beside it. A service worker is a static file, so it cannot
# read a `--dart-define` — the configuration is substituted into it at build
# time instead of being written into the repository.
web/firebase-messaging-sw.js

# Kotlin build logs
android/.kotlin/
